SimName = "AbacusAurora_large_c000_ph430"

#include "../Large.par2"
#include "../PNG.par2"
#include "../../Cosmologies/abacus_cosm000/cosm.def"

ZD_Seed = @ZD_Seed@+430-430

# White noise made for this box, grid and seed (built from BoxSize, NP and ZD_Seed, so it always
# matches the seed in the header). Using ZD_Seed = 3943 so this is
# /tmp/AbacusAurora_run/Resources/PNGNoise/Large_L8000_N12000_seed3943
ZD_WhiteNoiseDirectory = "$ABACUS_RESOURCE_ROOT$/PNGNoise/Large_L" + str(int(@BoxSize@)) + "_N" + str(round(@NP@**(1/3.))) + "_seed" + str(@ZD_Seed@)

# This is the Gaussian base case
ZD_f_NL = 0
ZD_f_NL_local = 1

