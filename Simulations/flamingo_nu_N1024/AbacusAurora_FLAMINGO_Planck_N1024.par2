SimName = "AbacusAurora_FLAMINGO_Planck_N1024"

#include "../FLAMINGO_N1024.par2"
#include "../../Cosmologies/abacus_cosm202/cosm.def"

# FLAMINGO Planck cosmology (abacus_cosm202), FLAMINGO-matched linear input (CLASS v2.9 + flamingo_prod.pre, z = 1 P_cb; FLAMINGO_MATCHING.md).
# Same as flamingo_nu_N2500/AbacusAurora_FLAMINGO_Planck_N2500.par2 except the template (NP = 1024^3).

# SCR flush pinned to PTHREAD, as in the 2500^3 boxes.
SCR_ConfigLines = ["SCR_COPY_TYPE=SINGLE", "SCR_SET_SIZE=8", "SCR_CACHE_SIZE=1", "SCR_FLUSH=1", "SCR_FLUSH_ASYNC=1", "SCR_FLUSH_TYPE=PTHREAD", "SCR_PREFIX_SIZE=0", "SCR_COPY_METADATA=0", "SCR_ASSIGN_OWNERSHIP=NONE"]
