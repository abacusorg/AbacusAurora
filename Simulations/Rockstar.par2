# This is the template for a test box that should we use for Rockstar tests. 
# This is sized so that we can improve the mass resolution by about 4x to 1600^3, the largest box on which we can run Rockstar in 256 GB.

## includes
#include "./$ABACUS_SITE$.def"
#include "../Cosmologies/abacus_cosm000/cosm.def"
#include "./base.def"

# Custom parameters
BoxSize = 217      # Matches the flagship mass exactly
NP = 800**3
CPD = 175     # PPC = 95
ZD_Seed = 12507  
NumZRanks = 2
LogVerbosity = -1

# We're going to use a lot of time slice outputs, fully sampled

