# These are the parameters for our standard 1.2 Gpc/h boxes.
# These should run on 15 nodes in a 6x5 domain
# Don't forget the cosm.def file and a ZD_Seed

# This is intended for a few cases, where we'll do P8 to z=4 to support Lya work.

#include "aurora.def"
#include "base.def"

BoxSize = 1215.
NP = 4480**3
CPD = 975
NumZRanks = 5

ZD_Seed = 243    # This will be the most common phase

# This version has two lightcones.
# The first is an octant to z=4, with denser coverage to z=4.
# The second is a fullsky to z=0.5, with sparse coverage.

LCOrigins = (0.,0.,0., 0., 0., 0.)
LCIsOctant = [1, 0]
LCZMax1 = [4.0, 0.]
LCZMax2 = [4.0, 0.5]
LCBoxRepeats = 4    
LCSamplerInner = ["subP8"] 
LCSamplerOuter = ["subP64"]
LCDoHealpix = [1]
LCHealpixZMax = [4.0, 0.5]
