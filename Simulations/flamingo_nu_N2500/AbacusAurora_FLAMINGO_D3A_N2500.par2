SimName = "AbacusAurora_FLAMINGO_D3A_N2500"

#include "../FLAMINGO.par2"
#include "../../Cosmologies/abacus_cosm207/cosm.def"

# FLAMINGO D3A cosmology (abacus_cosm207), FLAMINGO-matched linear input (CLASS v2.9 + flamingo_prod.pre, z = 1 P_cb; FLAMINGO_MATCHING.md).
# Run with neutrino_validation/production/pbs_flamingo.sh (sets ZD_EXTERNAL_NOISE_DIR to the N0 = 4096 FLAMINGO noise).

# Pin SCR to the PTHREAD flush settings the 9575f04 build was run with (aurora.def switched to SCR_FLUSH_TYPE=DFS on 2026-11-10).
SCR_ConfigLines = ["SCR_COPY_TYPE=SINGLE", "SCR_SET_SIZE=8", "SCR_CACHE_SIZE=1", "SCR_FLUSH=1", "SCR_FLUSH_ASYNC=1", "SCR_FLUSH_TYPE=PTHREAD", "SCR_PREFIX_SIZE=0", "SCR_COPY_METADATA=0", "SCR_ASSIGN_OWNERSHIP=NONE"]
