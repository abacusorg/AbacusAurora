#!/usr/bin/env python3
"""Remove files from DAOS in parallel.

dfuse serialises metadata ops, so threading alone buys ~7% and the interception
library alone ~26%; together they are ~7x faster than rm(1).
"""

import argparse
import os
import stat
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

MODULE_SETUP = "module use /soft/modulefiles && module load daos"
BOOTSTRAPPED = "_DAOSRM_BOOTSTRAPPED"
DEFAULT_JOBS = 64
# DAOS_PRELOAD alone is not enough: without the agent socket directory pil4dfs
# cannot reach the agent, and silently falls back to plain dfuse at a sixth the speed.
REQUIRED_ENV = ("DAOS_PRELOAD", "DAOS_AGENT_DRPC_DIR")


def resolve_preload():
    """Return ($DAOS_PRELOAD, environment) as `module load daos` would set them."""
    if all(name in os.environ for name in REQUIRED_ENV):
        return os.environ["DAOS_PRELOAD"], dict(os.environ)

    # Module chatter goes to stderr so it cannot corrupt the env dump.
    proc = subprocess.run(
        ["bash", "-lc", f"{{ {MODULE_SETUP}; }} >&2 && env -0"], capture_output=True
    )
    if proc.returncode != 0:
        sys.exit(f"daosrm: `{MODULE_SETUP}` failed:\n{proc.stderr.decode(errors='replace')}")
    env = {}
    for entry in proc.stdout.split(b"\0"):
        key, sep, value = entry.partition(b"=")
        if sep:
            env[os.fsdecode(key)] = os.fsdecode(value)
    return env.get("DAOS_PRELOAD"), env


def bootstrap():
    """Re-exec with the interception library preloaded.

    ld.so reads LD_PRELOAD only at execve, so a process cannot preload into itself.
    """
    preload, env = resolve_preload()
    if not preload:
        sys.exit(f"daosrm: DAOS_PRELOAD unset after `{MODULE_SETUP}`")
    if not os.path.exists(preload):
        sys.exit(f"daosrm: DAOS_PRELOAD={preload} does not exist")
    env["LD_PRELOAD"] = preload
    env[BOOTSTRAPPED] = "1"
    os.execve(sys.executable, [sys.executable, os.path.realpath(__file__), *sys.argv[1:]], env)


def scan(directory):
    """Entry paths of one directory, without stat'ing them."""
    try:
        with os.scandir(directory) as entries:
            return [os.path.join(directory, entry.name) for entry in entries], None
    except OSError as exc:
        return [], exc


def is_dir(path):
    """True for a real directory. A symlink to one is not descended, so it is not."""
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def walk(tops, pool):
    """Every file under tops, and every directory including tops.

    pil4dfs reports all dirents as DT_UNKNOWN, so classifying an entry costs a stat.
    Scans and stats both run on the pool to keep that off the critical path.
    """
    files, dirs, errors = [], [], []
    level = list(tops)
    while level:
        dirs.extend(level)
        paths = []
        for directory, (found, exc) in zip(level, pool.map(scan, level)):
            paths.extend(found)
            if exc is not None:
                errors.append((directory, exc))
        subdirs = []
        for path, isdir in zip(paths, pool.map(is_dir, paths)):
            (subdirs if isdir else files).append(path)
        level = subdirs
    return files, dirs, errors


def collect(paths, recursive, pool):
    """Split the targets into files to unlink and directories to rmdir."""
    files, tops = [], []
    for top in paths:
        try:
            mode = os.lstat(top).st_mode
        except OSError:
            files.append(top)  # reported by the unlink phase, or swallowed by -f
            continue
        if not stat.S_ISDIR(mode):
            files.append(top)
        elif recursive:
            tops.append(top)
        else:
            sys.exit(f"daosrm: {top}: is a directory")
    walked, dirs, errors = walk(tops, pool) if tops else ([], [], [])
    return files + walked, dirs, errors


def apply(op, paths, pool, force, verbose):
    """Run op over paths on the pool; return the failure count."""

    def one(path):
        try:
            op(path)
        except OSError as exc:
            return path, exc
        return path, None

    failures = 0
    for path, exc in pool.map(one, paths):
        if exc is None:
            if verbose:
                print(f"removed {path}")
        elif force and isinstance(exc, FileNotFoundError):
            pass
        else:
            print(f"daosrm: {path}: {exc.strerror}", file=sys.stderr)
            failures += 1
    return failures


def main():
    parser = argparse.ArgumentParser(prog="daosrm", description=__doc__.splitlines()[0])
    parser.add_argument("paths", nargs="*")
    parser.add_argument("-r", "-R", "--recursive", action="store_true")
    parser.add_argument("-f", "--force", action="store_true",
                        help="ignore missing paths, never prompt")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("-n", "--dry-run", action="store_true")
    parser.add_argument("-j", "--jobs", type=int, default=DEFAULT_JOBS,
                        help=f"parallel removals (default {DEFAULT_JOBS}; DAOS saturates near 32)")
    args = parser.parse_args()

    if not args.paths:
        return 0 if args.force else parser.error("missing operand")
    if args.jobs < 1:
        parser.error("--jobs must be >= 1")
    for path in args.paths:
        if os.path.abspath(path) == os.sep:
            sys.exit("daosrm: refusing to operate on /")

    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
        files, dirs, errors = collect(args.paths, args.recursive, pool)
        for path, exc in errors:
            print(f"daosrm: {path}: {exc.strerror}", file=sys.stderr)
        failures = len(errors)

        if args.dry_run:
            print(f"would remove {len(files)} file(s) and {len(dirs)} director(ies)")
            return 0

        failures += apply(os.unlink, files, pool, args.force, args.verbose)

        # A directory is only empty once its children are gone, so peel by depth.
        by_depth = {}
        for path in dirs:
            by_depth.setdefault(os.path.abspath(path).count(os.sep), []).append(path)
        for depth in sorted(by_depth, reverse=True):
            failures += apply(os.rmdir, by_depth[depth], pool, args.force, args.verbose)

    return 1 if failures else 0


if __name__ == "__main__":
    if BOOTSTRAPPED not in os.environ:
        bootstrap()
    sys.exit(main())
