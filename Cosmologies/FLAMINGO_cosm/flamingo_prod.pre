# FLAMINGO production CLASS settings. Use INSTEAD of ../abacus_base.pre for FLAMINGO-matched inputs:
#   ~/class_public/class <name>.ini flamingo_prod.pre        (AbacusAurora's CLASS, v2.9.0; reproduces production P_cb to 2e-8)
# Settings = what monofonIC 3FA_nu_panph@0ba5b9d (src/plugins/transfer_3FA_CLASS.cc) passed to CLASS v2.9.4 (ohahn/class_public@7552778f)
# for the FLAMINGO production ICs, plus Abacus-style outputs. recombination is deliberately NOT set: the v2.9 default (RECFAST) is what
# production used. Do not add abacus_base.pre's "recombination = HyRec" (2011 HyRec): it raises the BAO amplitude by 0.33%.
# The CLASS.ini supplies the cosmology: h, omega_b, omega_cdm, A_s, n_s, alpha_s, N_ur, N_ncdm, omega_ncdm (+ deg_ncdm), w0_fld, wa_fld.
# See FLAMINGO_MATCHING.md.

# fixed physics choices (as production)
Omega_k = 0
Omega_fld = 0
Omega_scf = 0
T_cmb = 2.7255
YHe = 0.245421
reio_parametrization = reio_none
gauge = synchronous
P_k_ini type = analytic_Pk

# precision (monofonIC 3FA_CLASS plugin, verbatim)
k_per_decade_for_pk = 100
k_per_decade_for_bao = 100
compute damping scale = yes
tol_perturb_integration = 1.e-8
tol_background_integration = 1e-9
hyper_flat_approximation_nu = 7000.
transfer_neglect_delta_k_S_t0 = 0.17
transfer_neglect_delta_k_S_t1 = 0.05
transfer_neglect_delta_k_S_t2 = 0.17
transfer_neglect_delta_k_S_e = 0.13
delta_l_max = 1000
extra metric transfer functions = yes

# outputs (AbacusAurora convention: CLASS_power = z2_pk_cb, CLASS_transfer = z2_tk, i.e. z = 1)
output = mPk,dTk
P_k_max_h/Mpc = 50.
z_pk = 0.0, 1.0, 3.0, 7.0, 49.0
headers = yes
format = camb
write parameters = yes
write warnings = yes
input_verbose = 1
background_verbose = 1
thermodynamics_verbose = 1
spectra_verbose = 1
