set_reload emulator_core4.sm


macro hyper24 {
    # We're using the 4-d sphere, putting 24 well-spaced points
    # This is reusing the v_0..v_3 idea from AbacusSummit.  
    # However, we're going to add a v8 that is the theta_s_100 direction, and put the sphere is v0,v1,v2,v8 space.
    # This is 24 points.

    # Recall that c130..135 are +-1 in v0, v1, v2 (not v3).
    # We also have tighter paired offsets in all 4: 2% in sigma8, 3.3% in ochh, 1% in n_s, 2% in obhh
    # These 8 are equiv to \pm 1/6 in v0, 1/3 in v1, 1/6 in v2, 1/5 in v3
    # We also have the 7% sigma8 pairs, which are \pm 7/12 in v0, and of course c000.
    # These are 17 cases retained from AbacusSummit, 

    # We have to add the 2 pairs in the theta_s (v8) direction.
    # And we'll add a larger pair in the omega_b (v3) direction.

    # We then add 4 pairs in the bilateral omega_b plus each other parameter.  

    # These 55 cosmologies are also sampling rather well along the principal axes and around the 2-part edges.

    # cosm001 -- WMAP9 is -5.8% in ochh, -0.2% in obhh, -0.1% in ns, -4% in sigma8.  So that's -1/3 in v0, -1/2 in v1, and 0 in v2 and v3.
    # DESI DR2 LCDM is ochh = 0.1187 (-1%), sigma = 0.8162 which is probably sigma8_cb = 0.81964 (+1%), obhh = 0.022463 (+0.5%), ns = 0.9739 (+1%), 
    # so that's v0 = +1/12, v1 = -1/10, v2 = 1/6, v3 = 1/20.  So these are interior to the linear derivative set, close to c000.
    # High-tau will be a 58th in this space.

    # We are setting these up so that adjacent pairs are symmetric around c000
    set num = 0,37,1
    set num = num+230
    set v_0 = num*0.0
    set v_1 = v_0
    set v_2 = v_0
    set v_3 = v_0
    set v_4 = v_0
    set v_5 = v_0
    set v_6 = v_0
    set v_7 = v_0
    set v_8 = v_0

    set v_0[0] =  1.0
    set v_1[0] =  1.0

    set v_0[2] =  1.0
    set v_1[2] = -1.0

    set v_0[4] =  1.0
    set v_2[4] =  1.0

    set v_0[6] =  1.0
    set v_2[6] = -1.0
 
    set v_0[8] =  1.0
    set v_8[8] =  1.0

    set v_0[10] = 1.0
    set v_8[10] =-1.0


    set v_1[12] = 1.0
    set v_2[12] = 1.0

    set v_1[14] = 1.0
    set v_2[14] =-1.0

    set v_1[16] = 1.0
    set v_8[16] = 1.0

    set v_1[18] = 1.0
    set v_8[18] =-1.0

    set v_2[20] = 1.0
    set v_8[20] = 1.0

    set v_2[22] = 1.0
    set v_8[22] =-1.0

    # Now here are the cross-terms with omega_b 
    # Higher omega_b at fixed sigma8 increases large-scale power, so let's try to compensate that to focus on the degeneracy:
    # Reducing larger-scale power requires a bluer/larger n_s, a larger Omega_m h, or a smaller sigma8
    # Decreasing theta_s at fixed omega_m makes omega_m larger and omega_m*h larger.
    # At fixed theta_s, increasing omega_m requires h to be smaller, Omega_m bigger, and Omega_m h bigger
    set v_0[24] =-1.0   # Make sigma8 smaller as omega_b grows
    set v_3[24] = 1.0

    set v_1[26] = 1.0   # Make omega_m larger as omega_b grows
    set v_3[26] = 1.0

    set v_2[28] = 1.0    # Make n_s larger as omega_b grows
    set v_3[28] = 1.0

    set v_8[30] =-1.0    # I think this is the compensating direction
    set v_3[30] = 1.0

    do m=0,30,2 {
       set v_0[$m+1] = -v_0[$m]
       set v_1[$m+1] = -v_1[$m]
       set v_2[$m+1] = -v_2[$m]
       set v_8[$m+1] = -v_8[$m]
    }

    set v_0 = v_0/sqrt(2.0)
    set v_1 = v_1/sqrt(2.0)
    set v_2 = v_2/sqrt(2.0)
    set v_3 = v_3/sqrt(2.0)
    set v_8 = v_8/sqrt(2.0)

    # Now we need to add the v8 (theta_s) derivatives

    set num[32] = 220
    set v_8[32] = 0.5
    set num[33] = 221
    set v_8[33] =-0.5
    set num[34] = 222
    set v_8[34] = 1.0
    set num[35] = 223
    set v_8[35] =-1.0

    # And the larger omega_b derivative
    set num[36] = 224
    set v_3[36] = 1.0
    set num[37] = 225
    set v_3[37] =-1.0

    # Unlike AbacusSummit we are turning off the extra +-0.03 scatter in sigma8_cb.
    set unif = num*0.0

}



macro map_to_param {

    #set sigma8m = 0.807952*(1  + 0.12 *v_0 + 0.06*unif - 0.5/4*v_4)
    set sigma8cb = 0.811355*(1  + 0.12 *v_0 + 0.06*unif - 0.5/4*v_4)
    set ochh    = ln(0.1200)   + 0.165*v_6 + 0.100*v_1
    set ns      = 0.9649       + 0.05 *v_6 + 0.06 *v_2
    set obhh    = ln(0.02237)  + 0.10 *v_3
    set w0      = -1           - 0.2 *v_5 + 0.3  *v_4
    set wa      = 0            + 0.8  *v_5
    set Nur     = 2.0328       + 1.2  *v_6
    set nrun    = 0            + 0.05 *v_7
    set theta_s = 1 + 0.02*v_8     # This is the multiplicative scaling around c000; the actual central value is 1.041533

    #set varlist = < sigma8cb ochh ns obhh w0 wa Nur nrun num >
    set varlist = < sigma8cb ochh ns obhh >

    set ochh = exp(ochh)
    set obhh = exp(obhh)

    set ocbhh = ochh+obhh
    set winf = w0+wa

    #set varlist = < winf ocbhh > concat varlist
    set varlist = < ocbhh > concat varlist

    print emulator_core4.dat '%3d  %8.6f  %6.4f  %6.4f  %7.5f  %6.3f  %6.3f  %6.4f  %6.3f  %7.4f\n' \
        < num sigma8cb ochh ns obhh w0 wa Nur nrun theta_s >
    foreach var varlist {
        vecminmax $var min max
        echo
        echo $var  Min: $min   Max: $max
        st $var
        write +emulator_core4.dat \#  
        write +emulator_core4.dat \# $var  Min: $min  Max: $max   
        write +emulator_core4.dat \#       Mean: $mean +- $sig   Median: $med +- $siqr_sig
    }
}

macro doit {
    hyper24
    map_to_param
}
