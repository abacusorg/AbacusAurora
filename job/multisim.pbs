#!/bin/bash -l
#PBS -A Abacus
#PBS -l filesystems=flare
#PBS -l place=scatter
#PBS -l select=16
#PBS -l walltime=1:0:0
#PBS -q debug-scaling

# Runs one or more Abacus sims from a hash-keyed checkout against the production
# specs ($abacus_prod). Each sim gets an equal nodes_per_sim-node slice of the
# allocation and runs under onesim.sh (monitor + restart). Everything is provided
# by hashrun.sh, which stages the job inputs (jobspec + par2 list + env overrides
# + its own command line) into the prod repo's git-ignored out/<jobid>/ and routes
# PBS's stdout/stderr there too; per-sim provenance goes to each
# OutputDirectory/provenance/.

set -euo pipefail

: "${HASHRUN_PROD:?not set — submit via hashrun.sh}"
: "${PBS_MINUTES:?not set — submit via hashrun.sh (sets it from -t)}"

out=$HASHRUN_PROD/job/out/${PBS_JOBID%%.*}
cd "$out"
export HASHRUN_OUT="$out"          # onesim.sh copies the jobspec from here
source "$out/jobspec.sh"

. "$abacus_env"

# hashrun's -E overrides live in their own file, sourced here (after env.sh) so they
# win over its defaults; the exports are inherited by onesim -> abacus.run -> the ranks.
source "$out/env_overrides.sh"

source "$abacus_prod/job/daos.sh"

# --- Halt controls -----------------------------------------------------------
# Besides the per-sim WorkingDirectory/HALT file, Abacus's CheckHaltFile reads two
# env vars that let us stop EVERY sim in this allocation cleanly (and restartably)
# at once. Exported here so onesim -> abacus.run inherit them.
#
# 1) A shared, group-writeable halt file for this allocation: any teammate can
#    `touch` it to halt all sims. Named by the PBS job id so it's unique per job.
#    HALT_DIR must already exist and be group-writeable; adjust to your location.
HALT_DIR=/flare/Abacus/
export ABACUS_JOB_HALT_FILE="$HALT_DIR/HALT.${PBS_JOBID%%.*}"
# We (not Abacus) own this file's lifecycle: remove it whenever this script exits.
# Same trap tears the dfuse mounts back down.
daos_mounted=0
cleanup() {
    rm -f "$ABACUS_JOB_HALT_FILE"
    if (( daos_mounted )); then daos_unmount "${daos_conts[@]}"; fi
    return 0   # never let the trap mask the job's real exit code
}
trap cleanup EXIT

# 2) A wall-clock deadline so the job closes out before the allocation ends.
#    PBS won't tell us the remaining time, so derive it from PBS_MINUTES (set by
#    hashrun.sh from -t) minus a safety buffer, added to "now".
export HALT_BUFFER_MINUTES=30
halt_after_min=$(( PBS_MINUTES - HALT_BUFFER_MINUTES ))
if (( halt_after_min > 0 )); then
    export ABACUS_JOB_HALT_TIME=$(( $(date +%s) + halt_after_min * 60 ))
    echo "Halt controls: ABACUS_JOB_HALT_FILE=$ABACUS_JOB_HALT_FILE"
    echo "               ABACUS_JOB_HALT_TIME=$ABACUS_JOB_HALT_TIME (halt in ${halt_after_min} min)"
else
    echo "Halt controls: ABACUS_JOB_HALT_FILE=$ABACUS_JOB_HALT_FILE"
    echo "WARNING: PBS_MINUTES ($PBS_MINUTES) <= HALT_BUFFER_MINUTES ($HALT_BUFFER_MINUTES); not setting ABACUS_JOB_HALT_TIME"
fi
echo
# -----------------------------------------------------------------------------

# Sims to run: prefix each prod-relative par2 (from the job spec) with $abacus_prod.
par2s=("${par2s[@]/#/$abacus_prod/}")
num_sims=${#par2s[@]}
onesim="$abacus_prod/job/onesim.sh"   # not $BASH_SOURCE — PBS executes a spooled copy

# Node allocation: unique, sorted list (PBS_NODEFILE repeats a node per rank/chunk).
# nodes_per_sim comes from the job spec (falls back to the whole allocation if unset).
: "${PBS_NODEFILE:?not set — run under PBS}"
sort -u "$PBS_NODEFILE" > nodes.sorted
num_nodes=$(( $(wc -l < nodes.sorted) ))
nodes_per_sim=${nodes_per_sim:-$num_nodes}

required=$(( nodes_per_sim * num_sims ))
if (( required > num_nodes )); then
    echo "ERROR: nodes_per_sim($nodes_per_sim) x sims($num_sims) = $required nodes, only $num_nodes available" >&2
    exit 1
fi

# Node health. The persistent history of nodes that have killed sims before lives
# outside any one job (job/out is gitignored, so this does not dirty the prod tree
# that hashrun.sh insists is clean). nodehealth.py picks it up from the environment.
export ABACUS_NODEHEALTH=${ABACUS_NODEHEALTH:-$HASHRUN_PROD/job/out/nodehealth.tsv}
nodehealth="$abacus_prod/job/nodehealth.py"
mkdir -p "$out/nodehealth"

# Hold back nodes we already know are bad, so they are neither assigned to a sim
# nor handed out as a spare. order-nodes will yield rather than leave the sims
# unplaceable. Reordering here is safe: nodes.sorted is already our own reordered
# copy -- $PBS_NODEFILE itself is untouched, as daos.sh requires.
if [[ -r $nodehealth ]] && python "$nodehealth" order-nodes \
        --nodes nodes.sorted --good nodes.usable \
        --quarantine "$out/hostfile_quarantine" --required "$required"; then
    :
else
    echo "WARNING: nodehealth order-nodes unavailable; using the allocation as-is" >&2
    cp nodes.sorted nodes.usable
    : > "$out/hostfile_quarantine"
fi
num_usable=$(( $(wc -l < nodes.usable) ))
if (( required > num_usable )); then
    echo "ERROR: only $num_usable node(s) left after quarantine, need $required" >&2
    exit 1
fi

# Nodes past what the sims use become the spare pool that onesim.sh draws on when
# it blames a node for a crash.
export HOSTFILE_EXTRA="$out/hostfile_extra"
tail -n +"$(( required + 1 ))" nodes.usable > "$HOSTFILE_EXTRA"
echo "Allocation: $num_sims sim(s) x $nodes_per_sim node(s) = $required used;" \
     "$(( num_usable - required )) spare; $(( num_nodes - num_usable )) quarantined"
if [[ -n ${spare_nodes:-} ]] && (( num_usable - required < spare_nodes )); then
    echo "WARNING: asked for $spare_nodes spare(s), only $(( num_usable - required )) available" >&2
fi
echo

# --- Storage -------------------------------------------------------------------
# Where the storage roots point was decided at submit time (hashrun.sh recorded it in
# the spec and requested the matching daos_user_fs allocation); we replay it verbatim
# rather than re-deriving it. A mount that fails to come up is fatal rather than a
# silent fall back to flare, which would strand this sim's checkpoints where the next
# restart won't look.
export ABACUS_WORKING_ROOT=$working_root
export ABACUS_OUTPUT_ROOT=$output_root
export ABACUS_CHECKPOINT_ROOT=$checkpoint_root
export ABACUS_RESOURCE_ROOT=$resource_root
if (( ${#daos_conts[@]} )); then
    DAOS_POOL=$daos_pool
    echo "DAOS: pool $DAOS_POOL, mounting ${daos_conts[*]} on $num_nodes node(s)"
    daos_mount "${daos_conts[@]}" || exit 1
    daos_mounted=1
    mkdir -p "$ABACUS_WORKING_ROOT" "$ABACUS_OUTPUT_ROOT" "$ABACUS_CHECKPOINT_ROOT"
else
    echo "DAOS: off; all storage on flare"
fi
daos_mpirun_args "${#daos_conts[@]}"

echo "Storage roots: working=$ABACUS_WORKING_ROOT"
echo "               output=$ABACUS_OUTPUT_ROOT"
echo "               checkpoint=$ABACUS_CHECKPOINT_ROOT"
echo "               resources=$ABACUS_RESOURCE_ROOT"
echo "ABACUS_MPIRUN_ARGS=$ABACUS_MPIRUN_ARGS"
echo
# -------------------------------------------------------------------------------

# Launch each sim on its own node slice via the per-sim monitor. A failed sim is
# not fatal to the batch, so drop -e here and collect exit codes afterward.
set +e
pids=()
for i in "${!par2s[@]}"; do
    hf="$out/nodefile_part_$(printf '%03d' "$i")"
    start=$(( i * nodes_per_sim + 1 ))
    end=$(( (i + 1) * nodes_per_sim ))
    sed -n "${start},${end}p" nodes.usable > "$hf"

    # onesim.sh diagnoses a crash from its own output, so it has to be told which
    # file that is -- it cannot see the redirection we apply to it.
    export ABACUS_SIM_INDEX="$i" ABACUS_SIM_LOG="$out/sim_${i}.out"

    # < /dev/null keeps the backgrounded onesim from draining our stdin.
    "$onesim" "${par2s[$i]}" "$hf" ${overrides[@]+"${overrides[@]}"} < /dev/null > "sim_${i}.out" 2>&1 &
    pid=$!
    pids+=("$pid")
    echo "Sim $i: ${par2s[$i]} on $nodes_per_sim node(s) -> pid $pid, sim_${i}.out"
    sleep 10          # stagger PALS launches — critical!
done

# Block until every sim finishes; surface any failure to the job's exit code.
rc=0
for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
        echo "Sim $i (pid ${pids[$i]}) exited nonzero" >&2
        rc=1
    fi
done
echo "All $num_sims sim(s) finished (rc=$rc)"
exit "$rc"
